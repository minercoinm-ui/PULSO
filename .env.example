# GEMINI_API_KEY: Required for Gemini AI API calls if needed.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL of the store (on Vercel, VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are used automatically if unset).
APP_URL="MY_APP_URL"

# Supabase Configuration (Client - Safe for browser; root URL WITHOUT /rest/v1/)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Configuration (Server - NEVER expose service_role in frontend)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Mercado Pago Payment Gateway (Server-only)
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-your-access-token"
MERCADO_PAGO_WEBHOOK_SECRET="your-webhook-secret"

# Session Secret (Server-only)
SESSION_SECRET="replace-with-strong-random-secret"
